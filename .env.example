# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# Bot config
# ---------------------------------------------------------------------------
# Where the OpenWA gateway is running (the Docker container from the README)
OPENWA_URL=http://localhost:2785

# Admin API key OpenWA printed on first boot (also in OpenWA's data/.api-key),
# or the API_MASTER_KEY you set in OpenWA's .env
OPENWA_API_KEY=

# From: python -m scripts.setup_openwa create-session poc-bot
OPENWA_SESSION_ID=

# From: python -m scripts.setup_openwa groups   (looks like 120363xxxxxxxxxxxx@g.us)
WHATSAPP_GROUP_ID=

# Shared HMAC secret between OpenWA and the bot (min 16 chars). Generate one with:
#   python -c "import secrets; print(secrets.token_hex(24))"
WEBHOOK_SECRET=

# URL OpenWA (inside Docker) uses to reach the bot on your Mac
BOT_WEBHOOK_URL=http://host.docker.internal:8000/webhook

# Reply to commands typed from the bot's own phone? Off by default to avoid loops.
REPLY_TO_SELF=false

# ---------------------------------------------------------------------------
# AI event extraction (used by schedule-event)
# ---------------------------------------------------------------------------
# auto       -> anthropic if ANTHROPIC_API_KEY is set, else claude-cli if `claude` is installed, else ollama
# anthropic  -> Claude via API key
# claude-cli -> Claude via your local Claude Code login (no API key)
# ollama     -> local open-weight model (Qwen, Llama, ...)
LLM_PROVIDER=auto

# Optional model override. Defaults: anthropic=claude-haiku-4-5, claude-cli=haiku, ollama=qwen2.5:7b
LLM_MODEL=

# Seconds before an AI call is given up (local models on CPU can be slow)
LLM_TIMEOUT_SECONDS=120

# anthropic
ANTHROPIC_API_KEY=

# claude-cli
CLAUDE_CLI_PATH=claude
CLAUDE_CLI_EXTRA_ARGS=

# ollama
OLLAMA_HOST=http://localhost:11434
# How long Ollama keeps the model in memory after each request ("30m", "2h", or -1 = forever).
# The bot also loads the model at startup, so the first event isn't a slow cold start.
OLLAMA_KEEP_ALIVE=30m

# Reasoning pass for thinking models (qwen3, gemma4…).
# Leaving it on makes extraction slow and can run until the timeout. Options:
# false: default
# true
# a level like "high", or "default" for the model's own setting.
OLLAMA_THINK=

# Max tokens the model may generate, thinking included. Default 512 (the event JSON is ~150). -1 = no limit.
OLLAMA_NUM_PREDICT=

# Sampling temperature. Default 0 (deterministic). default uses the model's Modelfile value.
OLLAMA_TEMPERATURE=

# Timezone used to resolve "tomorrow", "next Friday"... (IANA name). Empty = this computer's timezone.
EVENT_TIMEZONE=America/Sao_Paulo